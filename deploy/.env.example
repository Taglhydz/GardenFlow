# Settings of the server : copy to deploy/.env (never committed) and fill in. Guide : deploy/README.md
# Random passwords and secrets : openssl rand -hex 32

# ---- Where the server runs ----
# Server at home, behind a Cloudflare tunnel :
COMPOSE_PROFILES=tunnel
SITE_PREFIX=http://
# Token of the tunnel (Cloudflare dashboard > Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
# VPS instead (Caddy gets the HTTPS certificate, ports 80 and 443 open) : leave these two empty
# COMPOSE_PROFILES=
# SITE_PREFIX=

# ---- MySQL (shared by the apps) ----
MYSQL_ROOT_PASSWORD=

# ---- GardenFlow ----
# Address of the API, without https:// : the app calls https://<this>/api
GARDENFLOW_DOMAIN=api.gardenflow.fr
GARDENFLOW_DB_PASSWORD=
# at least 32 characters : openssl rand -hex 48
GARDENFLOW_JWT_SECRET=
# address of the web app if it is published, comma separated if several (the mobile app doesn't need it)
GARDENFLOW_CORS_ORIGINS=
# Google sign-in : OAuth client id of type "Web" (the same as in frontend/config/prod.json)
GOOGLE_CLIENT_ID=
# Emails (verification, forgotten password). Empty SMTP_HOST = the emails are only written in the logs.
# Mailbox of the domain at OVH (SPF, DKIM and DMARC set on the domain) ; SMTP_FROM must use the address of SMTP_USER
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=no-reply@gardenflow.fr
SMTP_PASSWORD=
SMTP_FROM=GardenFlow <no-reply@gardenflow.fr>

# ---- Backups (backup.sh) ----
# rclone remote where the backups are copied, ENCRYPTED (crypt remote, see deploy/README.md), e.g. backups: . Empty = kept on the server only
BACKUP_REMOTE=
# days kept on the server / on the remote
BACKUP_KEEP_DAYS=7
BACKUP_REMOTE_KEEP_DAYS=30

# ---- Only to try the server on a PC where ports 80 / 443 are taken ----
# HTTP_PORT=8080
# HTTPS_PORT=8443
