# Copy this file to .env and fill in the values

PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=gardenuser
DB_PASSWORD=
DB_NAME=gardenflow
# Database used by `npm test` and `npm run db:reset:test` (it is wiped on every test run!)
DB_NAME_TEST=gardenflow_test

# JWT - use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=30d

# CORS - comma separated list of allowed origins (only needed for Flutter Web). Leave empty to allow all.
CORS_ORIGINS=

# Set to true to print response bodies in the request logger (development only)
LOG_RESPONSE_DATA=false
