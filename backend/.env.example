# Copy this file to .env and fill in the values

PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=gardenuser
DB_PASSWORD=
DB_NAME=gardenflow
# Database used by `npm test` and `npm run db:reset:test` (it is wiped on every test run!)
DB_NAME_TEST=gardenflow_test

# JWT - use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Address of this server as seen from a phone / a mail client (links of the verification emails)
# e.g. http://192.168.1.20:3000 to open the links from a phone on the same wifi. Default : http://localhost:PORT
PUBLIC_URL=

# Emails (verification of the address, forgotten password). Leave SMTP_HOST empty in development : the emails are printed in the terminal.
# Mailbox of the domain at OVH : SMTP_HOST=ssl0.ovh.net, SMTP_PORT=465, SMTP_USER=no-reply@gardenflow.fr, SMTP_FROM with the same address
# ⚠️  When the emails are really sent, PUBLIC_URL must not be a temporary tunnel (*.trycloudflare.com, ngrok...) :
# the spam filters silently drop the emails with such links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GardenFlow <no-reply@gardenflow.local>"

# CORS - comma separated list of allowed origins (only needed for Flutter Web). Leave empty to allow all (development only).
CORS_ORIGINS=

# Number of reverse proxies (nginx, a hosting platform...) in front of the server, e.g. 1. Empty = none.
# Needed online : without it, every user has the IP of the proxy and the rate limits block everybody at once.
TRUST_PROXY=

# Set to true to print response bodies in the request logger (development only)
LOG_RESPONSE_DATA=false

# Folder of the files sent by the users (profile photos). Default : backend/uploads
UPLOADS_DIR=

# Google sign-in : OAuth client id of type "Web" (Google Cloud Console > Google Auth Platform > Clients).
# Not a secret. Comma separated if several (web, iOS...). Empty = Google sign-in disabled
GOOGLE_CLIENT_ID=
